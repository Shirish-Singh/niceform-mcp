{
  "name": "niceform-mcp-server",
  "version": "0.3.0",
  "description": "MCP server for niceform.ai - Create forms using AI from any MCP-compatible client",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "niceform-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "niceform",
    "forms",
    "ai",
    "form-builder"
  ],
  "author": "niceform.ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shirish-Singh/niceform-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./server": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "mcpName": "io.github.Shirish-Singh/niceform-mcp"
}
